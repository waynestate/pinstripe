{
    "singleQuote": true,
    "semi": true,
    "printWidth": 100,
    "trailingComma": "all",
    "plugins": ["prettier-plugin-blade"],
    "overrides": [
        {
            "files": "*.blade.php",
            "options": {
                "parser": "blade",
                "tabWidth": 4
            }
        }
    ]
}
