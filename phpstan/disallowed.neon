# Pinstripe banned calls: the handful of calls no Wayne State app should ship.
# spaze/phpstan-disallowed-calls does the work; it ships in `require`, so the
# extension installer loads it for every PHPStan run, and this file only
# lists what it bans. Every cut includes it through base.neon.
#
# Each message says why and what to use instead, and ends with its OWASP Top
# 10:2025 category. Each ban has its own stable identifier, so an app that
# truly needs one call keeps it with a reasoned ignore on that line, e.g.
# `@phpstan-ignore pinstripe.banned.eval (why this one is safe)`.
#
# Each tip links to the Pinstripe page and to the CREED handbook rule.
#
# The list is deliberately short. md5(), sha1(), rand() and mt_rand() are not
# banned: they are fine for cache keys and other non-security uses, and the
# call on them is still open (README, "Not banned yet").
#
# Apps add their own bans to the same parameters in their phpstan.neon; NEON
# appends lists, so the app's entries join these rather than replacing them.
#
# One ban needs a rule of its own: curl_setopt() with a verify option set to
# false is two parameters at once, which the package cannot match (see
# src/PHPStan/CurlVerifyOffRule.php). It shares this file's message style,
# tip and identifier namespace.
rules:
    - WayneState\Pinstripe\PHPStan\CurlVerifyOffRule

parameters:
    disallowedFunctionCalls:
        -
            function: 'eval()'
            message: 'it runs a string as PHP code, so one untrusted value becomes remote code execution; write the code out, or pick a callable with match (OWASP A05:2025 Injection)'
            errorIdentifier: 'pinstripe.banned.eval'
            errorTip: 'See https://pinstripe.apps.wayne.edu/docs/reference/banned-calls.html and the CREED rule at https://creed.apps.wayne.edu/handbook/code.html#banned-patterns'
        -
            function: 'extract()'
            message: 'it turns array keys into local variables, so request data can overwrite any variable in scope; read the keys you need by name, or destructure the array (OWASP A05:2025 Injection)'
            errorIdentifier: 'pinstripe.banned.extract'
            errorTip: 'See https://pinstripe.apps.wayne.edu/docs/reference/banned-calls.html and the CREED rule at https://creed.apps.wayne.edu/handbook/code.html#banned-patterns'
        -
            function: 'var_dump()'
            message: 'debug output left in ships paths, config and secrets straight to the browser; log it with a PSR-3 logger (Log::debug() in Laravel), or step through with Xdebug (OWASP A02:2025 Security Misconfiguration)'
            errorIdentifier: 'pinstripe.banned.varDump'
            errorTip: 'See https://pinstripe.apps.wayne.edu/docs/reference/banned-calls.html and the CREED rule at https://creed.apps.wayne.edu/handbook/code.html#banned-patterns'
        -
            function: 'dd()'
            message: 'a dd() left in dumps internals to the browser and halts the request in production; log it with a PSR-3 logger (Log::debug() in Laravel), or step through with Xdebug (OWASP A02:2025 Security Misconfiguration)'
            errorIdentifier: 'pinstripe.banned.dd'
            errorTip: 'See https://pinstripe.apps.wayne.edu/docs/reference/banned-calls.html and the CREED rule at https://creed.apps.wayne.edu/handbook/code.html#banned-patterns'
        -
            function: 'dump()'
            message: 'a dump() left in ships paths, config and secrets straight to the browser; log it with a PSR-3 logger (Log::debug() in Laravel), or step through with Xdebug (OWASP A02:2025 Security Misconfiguration)'
            errorIdentifier: 'pinstripe.banned.dump'
            errorTip: 'See https://pinstripe.apps.wayne.edu/docs/reference/banned-calls.html and the CREED rule at https://creed.apps.wayne.edu/handbook/code.html#banned-patterns'

        # TLS checks turned off in raw PHP. curl_setopt_array() takes one
        # array, so a shape says it: the option's key (64 is
        # CURLOPT_SSL_VERIFYPEER, 81 is CURLOPT_SSL_VERIFYHOST) with a false
        # or 0 value, whatever else the array holds. A union of two shapes
        # matches far too much, so each key gets its own entry.
        # curl_setopt() itself is the custom rule named above.
        -
            function: 'curl_setopt_array()'
            message: 'it turns off TLS certificate checks (CURLOPT_SSL_VERIFYPEER false), so anyone on the network path can read or change the traffic; keep verification on, and for a private CA point CURLOPT_CAINFO at its bundle (OWASP A02:2025 Security Misconfiguration)'
            errorIdentifier: 'pinstripe.banned.curlVerifyOff'
            errorTip: 'See https://pinstripe.apps.wayne.edu/docs/reference/banned-calls.html and the CREED rule at https://creed.apps.wayne.edu/handbook/code.html#banned-patterns'
            allowExceptParamsAnywhere:
                -
                    position: 2
                    name: 'options'
                    typeString: 'array{64: 0|false}'
        -
            function: 'curl_setopt_array()'
            message: 'it turns off TLS certificate checks (CURLOPT_SSL_VERIFYHOST 0), so anyone on the network path can read or change the traffic; keep verification on, and for a private CA point CURLOPT_CAINFO at its bundle (OWASP A02:2025 Security Misconfiguration)'
            errorIdentifier: 'pinstripe.banned.curlVerifyOff'
            errorTip: 'See https://pinstripe.apps.wayne.edu/docs/reference/banned-calls.html and the CREED rule at https://creed.apps.wayne.edu/handbook/code.html#banned-patterns'
            allowExceptParamsAnywhere:
                -
                    position: 2
                    name: 'options'
                    typeString: 'array{81: 0|false}'

        # The same for PHP streams (file_get_contents() and friends): the ssl
        # context's verify_peer or verify_peer_name set to false, or
        # allow_self_signed set to true.
        -
            function: 'stream_context_create()'
            message: 'it turns off TLS certificate checks (ssl verify_peer false), so anyone on the network path can read or change the traffic; keep verification on, and for a private CA set the ssl cafile option to its bundle (OWASP A02:2025 Security Misconfiguration)'
            errorIdentifier: 'pinstripe.banned.streamVerifyOff'
            errorTip: 'See https://pinstripe.apps.wayne.edu/docs/reference/banned-calls.html and the CREED rule at https://creed.apps.wayne.edu/handbook/code.html#banned-patterns'
            allowExceptParamsAnywhere:
                -
                    position: 1
                    name: 'options'
                    typeString: 'array{ssl: array{verify_peer: false}}'
        -
            function: 'stream_context_create()'
            message: 'it turns off TLS host name checks (ssl verify_peer_name false), so anyone on the network path can read or change the traffic; keep verification on, and for a private CA set the ssl cafile option to its bundle (OWASP A02:2025 Security Misconfiguration)'
            errorIdentifier: 'pinstripe.banned.streamVerifyOff'
            errorTip: 'See https://pinstripe.apps.wayne.edu/docs/reference/banned-calls.html and the CREED rule at https://creed.apps.wayne.edu/handbook/code.html#banned-patterns'
            allowExceptParamsAnywhere:
                -
                    position: 1
                    name: 'options'
                    typeString: 'array{ssl: array{verify_peer_name: false}}'
        -
            function: 'stream_context_create()'
            message: 'it accepts self-signed certificates (ssl allow_self_signed true), so anyone on the network path can stand in for the server; keep it off, and for a private CA set the ssl cafile option to its bundle (OWASP A02:2025 Security Misconfiguration)'
            errorIdentifier: 'pinstripe.banned.streamVerifyOff'
            errorTip: 'See https://pinstripe.apps.wayne.edu/docs/reference/banned-calls.html and the CREED rule at https://creed.apps.wayne.edu/handbook/code.html#banned-patterns'
            allowExceptParamsAnywhere:
                -
                    position: 1
                    name: 'options'
                    typeString: 'array{ssl: array{allow_self_signed: true}}'

        # SQL built by joining strings, in raw PHP. PHPStan already knows
        # whether a string is a literal (literal-string): 'a' . 'b', a class
        # constant and a literal .= on a literal all are, while anything
        # joined with a variable is not. So the SQL argument must be a
        # literal, and values go in as bound parameters. Postgres's
        # pg_query() is left out: its connection argument is optional, so
        # the SQL has no fixed position. Bobby Tables need not apply.
        -
            function:
                - 'mysqli_query()'
                - 'mysqli_real_query()'
                - 'mysqli_multi_query()'
                - 'mysqli_prepare()'
            message: 'it runs SQL joined from strings, so one untrusted value can rewrite the query; keep the SQL a literal (constants and literal pieces joined together are fine) and pass every value as a bound parameter (OWASP A05:2025 Injection)'
            errorIdentifier: 'pinstripe.banned.joinedSql'
            errorTip: 'See https://pinstripe.apps.wayne.edu/docs/reference/banned-calls.html and the CREED rule at https://creed.apps.wayne.edu/handbook/code.html#banned-patterns'
            allowParamsAnywhere:
                -
                    position: 2
                    name: 'query'
                    typeString: 'literal-string'
        -
            function: 'oci_parse()'
            message: 'it runs SQL joined from strings, so one untrusted value can rewrite the query; keep the SQL a literal (constants and literal pieces joined together are fine) and pass every value with oci_bind_by_name() (OWASP A05:2025 Injection)'
            errorIdentifier: 'pinstripe.banned.joinedSql'
            errorTip: 'See https://pinstripe.apps.wayne.edu/docs/reference/banned-calls.html and the CREED rule at https://creed.apps.wayne.edu/handbook/code.html#banned-patterns'
            allowParamsAnywhere:
                -
                    position: 2
                    name: 'sql'
                    typeString: 'literal-string'

    # Laravel's HTTP client. The method entry covers chains such as
    # Http::acceptJson()->withoutVerifying(). The facade call
    # Http::withoutVerifying() is a static call, so it needs the static
    # entry; Larastan resolves it to the same PendingRequest method, which is
    # why both entries name PendingRequest. Raw apps never match either one.
    disallowedMethodCalls:
        -
            method: 'Illuminate\Http\Client\PendingRequest::withoutVerifying()'
            message: 'it turns off TLS certificate checks, so anyone on the network path can read or change the traffic; keep verification on, and for a private CA pass its bundle with withOptions and the verify option (OWASP A02:2025 Security Misconfiguration)'
            errorIdentifier: 'pinstripe.banned.withoutVerifying'
            errorTip: 'See https://pinstripe.apps.wayne.edu/docs/reference/banned-calls.html and the CREED rule at https://creed.apps.wayne.edu/handbook/code.html#banned-patterns'

        # The long way round to the same hole: Guzzle's verify option set to
        # false, through Laravel's withOptions() or Guzzle itself (the
        # client's config, and the options of each request). The shape
        # matches any options array whose verify key is false; a CA bundle
        # path in verify is the fix, and passes.
        -
            method: 'Illuminate\Http\Client\PendingRequest::withOptions()'
            message: 'it turns off TLS certificate checks (the verify option set to false), so anyone on the network path can read or change the traffic; keep verification on, and for a private CA set verify to the path of its bundle (OWASP A02:2025 Security Misconfiguration)'
            errorIdentifier: 'pinstripe.banned.verifyFalse'
            errorTip: 'See https://pinstripe.apps.wayne.edu/docs/reference/banned-calls.html and the CREED rule at https://creed.apps.wayne.edu/handbook/code.html#banned-patterns'
            allowExceptParamsAnywhere:
                -
                    position: 1
                    name: 'options'
                    typeString: 'array{verify: false}'
        -
            method: 'GuzzleHttp\Client::__construct()'
            message: 'it turns off TLS certificate checks (the verify option set to false), so anyone on the network path can read or change the traffic; keep verification on, and for a private CA set verify to the path of its bundle (OWASP A02:2025 Security Misconfiguration)'
            errorIdentifier: 'pinstripe.banned.verifyFalse'
            errorTip: 'See https://pinstripe.apps.wayne.edu/docs/reference/banned-calls.html and the CREED rule at https://creed.apps.wayne.edu/handbook/code.html#banned-patterns'
            allowExceptParamsAnywhere:
                -
                    position: 1
                    name: 'config'
                    typeString: 'array{verify: false}'
        -
            method:
                - 'GuzzleHttp\ClientInterface::request()'
                - 'GuzzleHttp\ClientInterface::requestAsync()'
            message: 'it turns off TLS certificate checks (the verify option set to false), so anyone on the network path can read or change the traffic; keep verification on, and for a private CA set verify to the path of its bundle (OWASP A02:2025 Security Misconfiguration)'
            errorIdentifier: 'pinstripe.banned.verifyFalse'
            errorTip: 'See https://pinstripe.apps.wayne.edu/docs/reference/banned-calls.html and the CREED rule at https://creed.apps.wayne.edu/handbook/code.html#banned-patterns'
            allowExceptParamsAnywhere:
                -
                    position: 3
                    name: 'options'
                    typeString: 'array{verify: false}'
        -
            method:
                - 'GuzzleHttp\ClientInterface::send()'
                - 'GuzzleHttp\ClientInterface::sendAsync()'
                - 'GuzzleHttp\Client::get()'
                - 'GuzzleHttp\Client::head()'
                - 'GuzzleHttp\Client::put()'
                - 'GuzzleHttp\Client::post()'
                - 'GuzzleHttp\Client::patch()'
                - 'GuzzleHttp\Client::delete()'
                - 'GuzzleHttp\Client::getAsync()'
                - 'GuzzleHttp\Client::headAsync()'
                - 'GuzzleHttp\Client::putAsync()'
                - 'GuzzleHttp\Client::postAsync()'
                - 'GuzzleHttp\Client::patchAsync()'
                - 'GuzzleHttp\Client::deleteAsync()'
            message: 'it turns off TLS certificate checks (the verify option set to false), so anyone on the network path can read or change the traffic; keep verification on, and for a private CA set verify to the path of its bundle (OWASP A02:2025 Security Misconfiguration)'
            errorIdentifier: 'pinstripe.banned.verifyFalse'
            errorTip: 'See https://pinstripe.apps.wayne.edu/docs/reference/banned-calls.html and the CREED rule at https://creed.apps.wayne.edu/handbook/code.html#banned-patterns'
            allowExceptParamsAnywhere:
                -
                    position: 2
                    name: 'options'
                    typeString: 'array{verify: false}'

        # SQL built by joining strings, through PDO, mysqli and Laravel's
        # connection (the same literal-string test as the functions above).
        # Laravel already types raw(), unprepared() and the query builder's
        # *Raw() methods as literal-string, so PHPStan reports a joined
        # string there by itself (argument.type); these are the calls it
        # leaves as plain string. The connection's classes are named one by
        # one: the query builder has insert(), update(), delete() and
        # select() too, and those take arrays and column names, not SQL.
        -
            method:
                - 'PDO::query()'
                - 'PDO::prepare()'
                - 'mysqli::query()'
                - 'mysqli::real_query()'
                - 'mysqli::multi_query()'
                - 'mysqli::prepare()'
                - 'mysqli_stmt::prepare()'
            message: 'it runs SQL joined from strings, so one untrusted value can rewrite the query; keep the SQL a literal (constants and literal pieces joined together are fine) and pass every value as a bound parameter (OWASP A05:2025 Injection)'
            errorIdentifier: 'pinstripe.banned.joinedSql'
            errorTip: 'See https://pinstripe.apps.wayne.edu/docs/reference/banned-calls.html and the CREED rule at https://creed.apps.wayne.edu/handbook/code.html#banned-patterns'
            allowParamsAnywhere:
                -
                    position: 1
                    name: 'query'
                    typeString: 'literal-string'
        -
            method: 'PDO::exec()'
            message: 'it runs SQL joined from strings, so one untrusted value can rewrite the query; keep the SQL a literal (constants and literal pieces joined together are fine) and pass every value as a bound parameter (OWASP A05:2025 Injection)'
            errorIdentifier: 'pinstripe.banned.joinedSql'
            errorTip: 'See https://pinstripe.apps.wayne.edu/docs/reference/banned-calls.html and the CREED rule at https://creed.apps.wayne.edu/handbook/code.html#banned-patterns'
            allowParamsAnywhere:
                -
                    position: 1
                    name: 'statement'
                    typeString: 'literal-string'
        -
            method:
                - 'Illuminate\Database\ConnectionInterface::select()'
                - 'Illuminate\Database\ConnectionInterface::selectOne()'
                - 'Illuminate\Database\ConnectionInterface::scalar()'
                - 'Illuminate\Database\ConnectionInterface::cursor()'
                - 'Illuminate\Database\ConnectionInterface::insert()'
                - 'Illuminate\Database\ConnectionInterface::update()'
                - 'Illuminate\Database\ConnectionInterface::delete()'
                - 'Illuminate\Database\ConnectionInterface::statement()'
                - 'Illuminate\Database\ConnectionInterface::affectingStatement()'
                - 'Illuminate\Database\Connection::select()'
                - 'Illuminate\Database\Connection::selectOne()'
                - 'Illuminate\Database\Connection::selectFromWriteConnection()'
                - 'Illuminate\Database\Connection::selectResultSets()'
                - 'Illuminate\Database\Connection::scalar()'
                - 'Illuminate\Database\Connection::cursor()'
                - 'Illuminate\Database\Connection::insert()'
                - 'Illuminate\Database\Connection::update()'
                - 'Illuminate\Database\Connection::delete()'
                - 'Illuminate\Database\Connection::statement()'
                - 'Illuminate\Database\Connection::affectingStatement()'
                - 'Illuminate\Database\Eloquent\Builder::fromQuery()'
            message: 'it runs SQL joined from strings, so one untrusted value can rewrite the query; keep the SQL a literal (constants and literal pieces joined together are fine) and pass every value as a binding (OWASP A05:2025 Injection)'
            errorIdentifier: 'pinstripe.banned.joinedSql'
            errorTip: 'See https://pinstripe.apps.wayne.edu/docs/reference/banned-calls.html and the CREED rule at https://creed.apps.wayne.edu/handbook/code.html#banned-patterns'
            allowParamsAnywhere:
                -
                    position: 1
                    name: 'query'
                    typeString: 'literal-string'

        # Laravel's own dd() and dump() methods: $users->dd(),
        # DB::table('users')->dumpRawSql(), $request->dump(), Http::get()->dd()
        # and the rest. They share the function bans' identifiers, so one
        # reasoned ignore reads the same either way. The match is on the
        # class that declares the method (or its trait), so only Laravel's
        # classes are caught; an app's own dump() method, like the look-alikes
        # in tests/fixtures/raw-disallowed, is left alone. Schema dumps
        # (php artisan schema:dump) are real work, not debugging, so the
        # Schema classes are excluded.
        -
            method:
                - 'Illuminate\*::dd()'
                - 'Illuminate\*::ddRawSql()'
                - 'Illuminate\*::ddHeaders()'
                - 'Illuminate\*::ddBody()'
                - 'Illuminate\*::ddJson()'
                - 'Illuminate\*::ddSession()'
            message: 'a dd() left in dumps internals to the browser and halts the request in production; log it with a PSR-3 logger (Log::debug() in Laravel), or step through with Xdebug (OWASP A02:2025 Security Misconfiguration)'
            errorIdentifier: 'pinstripe.banned.dd'
            errorTip: 'See https://pinstripe.apps.wayne.edu/docs/reference/banned-calls.html and the CREED rule at https://creed.apps.wayne.edu/handbook/code.html#banned-patterns'
        -
            method:
                - 'Illuminate\*::dump()'
                - 'Illuminate\*::dumpRawSql()'
                - 'Illuminate\*::dumpHeaders()'
                - 'Illuminate\*::dumpSession()'
            exclude:
                - 'Illuminate\Database\Schema\*'
            message: 'a dump() left in ships paths, config and secrets straight to the browser; log it with a PSR-3 logger (Log::debug() in Laravel), or step through with Xdebug (OWASP A02:2025 Security Misconfiguration)'
            errorIdentifier: 'pinstripe.banned.dump'
            errorTip: 'See https://pinstripe.apps.wayne.edu/docs/reference/banned-calls.html and the CREED rule at https://creed.apps.wayne.edu/handbook/code.html#banned-patterns'
    disallowedStaticCalls:
        -
            method: 'Illuminate\Http\Client\PendingRequest::withoutVerifying()'
            message: 'it turns off TLS certificate checks, so anyone on the network path can read or change the traffic; keep verification on, and for a private CA pass its bundle with withOptions and the verify option (OWASP A02:2025 Security Misconfiguration)'
            errorIdentifier: 'pinstripe.banned.withoutVerifying'
            errorTip: 'See https://pinstripe.apps.wayne.edu/docs/reference/banned-calls.html and the CREED rule at https://creed.apps.wayne.edu/handbook/code.html#banned-patterns'
        -
            method: 'Illuminate\Http\Client\PendingRequest::withOptions()'
            message: 'it turns off TLS certificate checks (the verify option set to false), so anyone on the network path can read or change the traffic; keep verification on, and for a private CA set verify to the path of its bundle (OWASP A02:2025 Security Misconfiguration)'
            errorIdentifier: 'pinstripe.banned.verifyFalse'
            errorTip: 'See https://pinstripe.apps.wayne.edu/docs/reference/banned-calls.html and the CREED rule at https://creed.apps.wayne.edu/handbook/code.html#banned-patterns'
            allowExceptParamsAnywhere:
                -
                    position: 1
                    name: 'options'
                    typeString: 'array{verify: false}'

        # SQL joined from strings off the DB facade (DB::select() and the
        # rest; Larastan resolves the facade to the connection) or off a
        # model (User::fromQuery()). The same list as the method entry.
        -
            method:
                - 'Illuminate\Database\ConnectionInterface::select()'
                - 'Illuminate\Database\ConnectionInterface::selectOne()'
                - 'Illuminate\Database\ConnectionInterface::scalar()'
                - 'Illuminate\Database\ConnectionInterface::cursor()'
                - 'Illuminate\Database\ConnectionInterface::insert()'
                - 'Illuminate\Database\ConnectionInterface::update()'
                - 'Illuminate\Database\ConnectionInterface::delete()'
                - 'Illuminate\Database\ConnectionInterface::statement()'
                - 'Illuminate\Database\ConnectionInterface::affectingStatement()'
                - 'Illuminate\Database\Connection::select()'
                - 'Illuminate\Database\Connection::selectOne()'
                - 'Illuminate\Database\Connection::selectFromWriteConnection()'
                - 'Illuminate\Database\Connection::selectResultSets()'
                - 'Illuminate\Database\Connection::scalar()'
                - 'Illuminate\Database\Connection::cursor()'
                - 'Illuminate\Database\Connection::insert()'
                - 'Illuminate\Database\Connection::update()'
                - 'Illuminate\Database\Connection::delete()'
                - 'Illuminate\Database\Connection::statement()'
                - 'Illuminate\Database\Connection::affectingStatement()'
                - 'Illuminate\Database\Eloquent\Builder::fromQuery()'
            message: 'it runs SQL joined from strings, so one untrusted value can rewrite the query; keep the SQL a literal (constants and literal pieces joined together are fine) and pass every value as a binding (OWASP A05:2025 Injection)'
            errorIdentifier: 'pinstripe.banned.joinedSql'
            errorTip: 'See https://pinstripe.apps.wayne.edu/docs/reference/banned-calls.html and the CREED rule at https://creed.apps.wayne.edu/handbook/code.html#banned-patterns'
            allowParamsAnywhere:
                -
                    position: 1
                    name: 'query'
                    typeString: 'literal-string'

        # The same dd() and dump() methods called off a facade, such as
        # Http::dd(); Larastan resolves the facade to the class behind it.
        -
            method:
                - 'Illuminate\*::dd()'
            message: 'a dd() left in dumps internals to the browser and halts the request in production; log it with a PSR-3 logger (Log::debug() in Laravel), or step through with Xdebug (OWASP A02:2025 Security Misconfiguration)'
            errorIdentifier: 'pinstripe.banned.dd'
            errorTip: 'See https://pinstripe.apps.wayne.edu/docs/reference/banned-calls.html and the CREED rule at https://creed.apps.wayne.edu/handbook/code.html#banned-patterns'
        -
            method:
                - 'Illuminate\*::dump()'
            exclude:
                - 'Illuminate\Database\Schema\*'
            message: 'a dump() left in ships paths, config and secrets straight to the browser; log it with a PSR-3 logger (Log::debug() in Laravel), or step through with Xdebug (OWASP A02:2025 Security Misconfiguration)'
            errorIdentifier: 'pinstripe.banned.dump'
            errorTip: 'See https://pinstripe.apps.wayne.edu/docs/reference/banned-calls.html and the CREED rule at https://creed.apps.wayne.edu/handbook/code.html#banned-patterns'
