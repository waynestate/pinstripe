# Pinstripe base PHPStan config: level 8 for new code, as set by the coding standard.
# The PHP version is inferred from the consumer's composer.json, not pinned here.
parameters:
    level: 8
    reportIgnoresWithoutComments: true
    reportUnmatchedIgnoredErrors: true
    # phpstan/phpstan-strict-rules ships in `require`, so the extension
    # installer loads it for every PHPStan run. The base cut keeps its rules
    # off; phpstan/strict.neon turns them back on for apps that opt in.
    strictRules:
        allRules: false
    # The same package also sets these two parameters to true
    # unconditionally, even while strictRules.allRules stays off. PHPStan
    # checks phpdoc method signatures from level 3 up, so with the
    # parameters leaked in, this cut would report maybe-mismatched
    # overrides and inspect static method overrides as well, making it
    # stricter than documented. Off here; phpstan/strict.neon turns them
    # back on.
    reportMaybesInMethodSignatures: false
    reportStaticMethodSignatures: false
