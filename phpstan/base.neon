# Pinstripe base PHPStan config: level 8 for new code, as set by the coding standard.
# The PHP version is inferred from the consumer's composer.json, not pinned here.
parameters:
    level: 8
    reportIgnoresWithoutComments: true
    reportUnmatchedIgnoredErrors: true
    # phpstan/phpstan-strict-rules ships in `require`, so the extension
    # installer loads it for every PHPStan run. The base cut keeps its rules
    # off; phpstan/strict.neon turns them back on for apps that opt in.
    strictRules:
        allRules: false
