# Pinstripe PHPStan config for new apps that want the strict cut: everything
# in base.neon, plus phpstan/phpstan-strict-rules. The extension installer
# already loads the package; this preset simply turns its rules on.
includes:
    - base.neon

parameters:
    strictRules:
        allRules: true
    # The strict cut keeps the two signature parameters that
    # phpstan/phpstan-strict-rules forces on, so apps that opt in also get
    # maybe-mismatched overrides and static method overrides reported.
    reportMaybesInMethodSignatures: true
    reportStaticMethodSignatures: true
    # The four noisy parameters that base.neon pins off.
    checkDynamicProperties: true
    reportMaybesInPropertyPhpDocTypes: true
    reportWrongPhpDocTypeInVarTag: true
    reportNonIntStringArrayKey: true
