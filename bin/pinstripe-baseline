#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * pinstripe-baseline: count a PHPStan baseline's ignored errors, and fail
 * when the baseline grows. One PHP command, every OS.
 *
 * A baseline is a tailor's chalk line: it marks the fabric as it is, and
 * every release you take it in, never let it out. This command is the tape
 * measure that notices when somebody lets it out.
 *
 * A baseline is only for apps adopting Pinstripe late, and they say so in
 * their composer.json: "extra": { "pinstripe": { "legacy": true } }. Every
 * command checks that flag before it reads the baseline; new apps never set
 * it, and a missing flag is a usage error.
 *
 * Usage:
 *   pinstripe-baseline count [--composer=<path>] [phpstan-baseline.neon]
 *   pinstripe-baseline check [--max=<n>] [--against=<git-ref>] [--composer=<path>] [phpstan-baseline.neon]
 *
 * Exit codes: 0 ok, 1 the baseline grew, 2 usage or baseline problem.
 */

// Installed in an app, this loads the app's autoloader, whose "files" entries
// run on require. An old package there prints deprecations on a new PHP, and
// they would land in front of the count a script reads. They are the app's
// to fix, not this command's to print, so they are muted while it loads.
$pinstripeErrorLevel = error_reporting(error_reporting() & ~E_DEPRECATED & ~E_USER_DEPRECATED);
foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;

        break;
    }
}
error_reporting($pinstripeErrorLevel);

use Composer\InstalledVersions;
use WayneState\Pinstripe\Baseline;
use WayneState\Pinstripe\BaselineException;
use WayneState\Pinstripe\Update\InstallKind;
use WayneState\Pinstripe\Update\PackagistFetcher;
use WayneState\Pinstripe\Update\UpdateCache;
use WayneState\Pinstripe\Update\UpdateNotice;

function pinstripe_baseline_usage(): never
{
    fwrite(STDERR, "usage: pinstripe-baseline count [--composer=<path>] [phpstan-baseline.neon]\n");
    fwrite(STDERR, "       pinstripe-baseline check [--max=<n>] [--against=<git-ref>] [--composer=<path>] [phpstan-baseline.neon]\n");
    exit(2);
}

function pinstripe_baseline_fail(string $message): never
{
    fwrite(STDERR, $message . "\n");
    exit(2);
}

// After any command finishes, one line on stderr when a newer stable release
// exists, with the command that updates this install. It reads the running
// version from Composer's InstalledVersions, so a source checkout, where the
// package is not in its own vendor, stays silent. Every step is wrapped: the
// notice never changes stdout or an exit code.
function pinstripe_baseline_notice(array $argv): void
{
    try {
        $env = getenv();
        if ($env === false) {
            $env = [];
        }
        if (!class_exists(InstalledVersions::class)) {
            return;
        }
        $version = InstalledVersions::getPrettyVersion('waynestate/pinstripe');
        if (!is_string($version)) {
            return;
        }
        $root = dirname(__DIR__);
        $notice = new UpdateNotice(
            'pinstripe',
            $root,
            InstallKind::detect($root, $env),
            new UpdateCache('pinstripe'),
            new PackagistFetcher(),
            static fn (): int => time(),
        );
        $notice->run($env, $argv, $version, STDERR);
    } catch (Throwable) {
        // The notice never gets in the way of the count.
    }
}

$arguments = array_slice($argv, 1);
if ($arguments === []) {
    pinstripe_baseline_usage();
}

$command = $arguments[0];
$rest = array_slice($arguments, 1);

$path = 'phpstan-baseline.neon';
$max = null;
$against = null;
$composer = 'composer.json';

foreach ($rest as $argument) {
    if ($command === 'check' && str_starts_with($argument, '--max=')) {
        $value = substr($argument, strlen('--max='));
        if (!ctype_digit($value)) {
            pinstripe_baseline_fail("error: --max expects a non-negative integer, got '{$value}'.");
        }
        $max = (int) $value;
    } elseif ($command === 'check' && str_starts_with($argument, '--against=')) {
        $value = substr($argument, strlen('--against='));
        if ($value === '') {
            pinstripe_baseline_fail('error: --against expects a git ref.');
        }
        $against = $value;
    } elseif (str_starts_with($argument, '--composer=')) {
        $value = substr($argument, strlen('--composer='));
        if ($value === '') {
            pinstripe_baseline_fail('error: --composer expects a path to composer.json.');
        }
        $composer = $value;
    } elseif (str_starts_with($argument, '--')) {
        pinstripe_baseline_usage();
    } else {
        $path = $argument;
    }
}

switch ($command) {
    case 'count':
        try {
            Baseline::requireLegacyFlag($composer);
            echo Baseline::countFile($path), "\n";
        } catch (BaselineException $exception) {
            pinstripe_baseline_fail($exception->getMessage());
        }
        pinstripe_baseline_notice($argv);
        exit(0);

    case 'check':
        if ($max === null && $against === null) {
            pinstripe_baseline_usage();
        }

        try {
            Baseline::requireLegacyFlag($composer);
            $count = Baseline::countFile($path);

            if ($max !== null && $count > $max) {
                fwrite(STDERR, "baseline grew: {$count} errors, the most allowed is {$max}\n");
                pinstripe_baseline_notice($argv);
                exit(1);
            }

            if ($against !== null) {
                $allowed = Baseline::countAtRef($path, $against);
                if ($count > $allowed) {
                    fwrite(STDERR, "baseline grew: {$count} errors, the most allowed is {$allowed}\n");
                    pinstripe_baseline_notice($argv);
                    exit(1);
                }
            }
        } catch (BaselineException $exception) {
            pinstripe_baseline_fail($exception->getMessage());
        }

        pinstripe_baseline_notice($argv);
        exit(0);

    default:
        pinstripe_baseline_usage();
}
