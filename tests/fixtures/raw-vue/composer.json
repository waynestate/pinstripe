{
    "name": "waynestate/pinstripe-fixture-raw-vue",
    "description": "A minimal raw PHP app with a Vue front end that proves Pinstripe's PHP and JS presets agree on one app.",
    "type": "project",
    "repositories": [
        {
            "type": "path",
            "url": "../../..",
            "options": {
                "symlink": false
            }
        }
    ],
    "require": {
        "php": "^8.3",
        "waynestate/pinstripe": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
