{
    "name": "waynestate/pinstripe",
    "description": "The coding standard for the Wayne State app stack: shared Pint and PHPStan presets.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/pint": "^1.32",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3"
    },
    "suggest": {
        "larastan/larastan": "^3.13 (Laravel apps: include phpstan/laravel.neon)",
        "rector/rector": "^2.8 (apps: use rector/base.php from your rector.php)"
    },
    "require-dev": {
        "phpunit/phpunit": "^12",
        "rector/rector": "^2.8"
    },
    "autoload-dev": {
        "psr-4": {
            "WayneState\\Pinstripe\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "ci": [
            "@composer validate --strict",
            "phpunit",
            "@composer audit"
        ]
    },
    "scripts-descriptions": {
        "ci": "The full CI contract: validate composer.json, run the PHPUnit suite (Pint and PHPStan against the fixtures), audit dependencies. Same command on GitLab and GitHub."
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "process-timeout": 900
    }
}
