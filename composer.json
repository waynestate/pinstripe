{
    "name": "waynestate/pinstripe",
    "description": "The coding standard for the Wayne State app stack: shared Pint and PHPStan presets.",
    "homepage": "https://pinstripe.apps.wayne.edu/",
    "support": {
        "source": "https://github.com/waynestate/pinstripe"
    },
    "type": "library",
    "license": "MIT",
    "bin": [
        "bin/pinstripe-baseline"
    ],
    "require": {
        "php": "^8.3",
        "laravel/pint": "^1.32",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "nette/neon": "^3.4"
    },
    "suggest": {
        "larastan/larastan": "^3.13 (Laravel apps: include phpstan/laravel.neon)",
        "rector/rector": "^2.8 (apps: use rector/base.php from your rector.php)"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/framework": "^11 || ^12 || ^13",
        "phpunit/phpunit": "^12",
        "rector/rector": "^2.8"
    },
    "autoload": {
        "psr-4": {
            "WayneState\\Pinstripe\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WayneState\\Pinstripe\\Tests\\": "tests/",
            "Pinstripe\\Fixtures\\Laravel\\": "tests/fixtures/laravel/src/"
        }
    },
    "scripts": {
        "ci": [
            "@composer validate --strict",
            "phpunit",
            "@site:agent-ready-check",
            "@composer audit"
        ],
        "site:agent-ready": "php bin/agent-ready.php",
        "site:agent-ready-check": "php bin/agent-ready.php --check"
    },
    "scripts-descriptions": {
        "ci": "The full CI contract: validate composer.json, run the PHPUnit suite (Pint and PHPStan against the fixtures), check the agent-ready files, audit dependencies. Same command on GitLab and GitHub.",
        "site:agent-ready": "Rewrite the Markdown twins, llms.txt, llms-full.txt, robots.txt and sitemap.xml in site/ (Squire's agent-ready kit).",
        "site:agent-ready-check": "Fail when the agent-ready files are stale, a page lacks its Markdown link, a prompt drifts from the docs, or the kit was edited here."
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "process-timeout": 900
    }
}
