{
    "name": "waynestate/pinstripe",
    "description": "The coding standard for the Wayne State app stack: shared Pint and PHPStan presets.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/pint": "^1.32",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3"
    },
    "suggest": {
        "larastan/larastan": "^3.13 (Laravel apps: include phpstan/laravel.neon)"
    },
    "require-dev": {
        "phpunit/phpunit": "^12"
    },
    "autoload-dev": {
        "psr-4": {
            "WayneState\\Pinstripe\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
